# Backend barebones: Fastify + MySQL/MariaDB.
# Copiá este archivo a ".env" y completá los valores. Nunca versiones ".env".

DB_HOST=127.0.0.1
DB_NAME=sabores_barebones
DB_USER=root
DB_PASS=

# Clave de firma de los JWT (mínimo 32 caracteres). Generala con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

JWT_TTL=900
SESSION_DAYS=7

# '' = mismo origen (recomendado detrás de Apache).
CORS_ORIGIN=

# auto = Secure solo si la request llega por HTTPS.
COOKIE_SECURE=auto

# 1 = errores detallados (solo desarrollo).
APP_DEBUG=0

# Cuenta admin inicial que crea `npm run create-admin`.
ADMIN_USER=
ADMIN_PASS=

# Servidor interno detrás de Apache.
PORT=3002
BASE_PATH=/sabores-barebones/api
COOKIE_PATH=/sabores-barebones/api
TRUST_PROXY=127.0.0.1
