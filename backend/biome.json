{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "files": { "ignoreUnknown": true, "includes": ["**", "!dist", "!node_modules"] },
    "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 4, "lineWidth": 320, "lineEnding": "lf" },
    "linter": { "enabled": true, "rules": { "preset": "recommended" } },
    "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "single", "quoteProperties": "preserve", "arrowParentheses": "asNeeded", "semicolons": "always", "bracketSpacing": true, "trailingCommas": "none" } }
}
